<?xml version="1.0"?>
<!--
  sentry24: 24-sentry, generated from the CAD by tools/build_sentry_urdf_assets.py
  (Blender) + tools/prepare_sentry_urdf.py.

  Frame: URDF / REP-103 body frame (metres, +X forward, +Y left, +Z up).
  Variant: ROS viewer (mesh visuals carry the Godot->REP-103 rotation).
  The simulator's Phase 5 loader converts every pose and axis to the Godot
  frame; mesh files are authored in the Godot frame (Y up, -Z forward),
  which is why the visual origins are all identity.

  Chain:
    base_link
      -> wheel_front_{left,right}_joint   (continuous, axle)
      -> steer_rear_{left,right}_joint    (revolute about body Z)
           -> wheel_rear_{left,right}_joint (continuous, axle)
      -> gimbal_yaw_joint   (revolute about body Z, big-yaw bearing)
           -> gimbal_yaw_link
                -> gimbal_pitch_joint (revolute about body Y, launcher pitch bearing)
                     -> gimbal_pitch_link
                          -> camera_joint -> camera_link
                               -> camera_optical_joint -> camera_optical_frame
                          -> shot_joint -> shot_direction

  Source CAD: 24哨兵-总装.glb
-->
<robot name="sentry24">

  <material name="body_grey">
    <color rgba="0.52 0.54 0.56 1.0"/>
  </material>
  <material name="steer_grey">
    <color rgba="0.45 0.47 0.49 1.0"/>
  </material>
  <material name="rubber_black">
    <color rgba="0.10 0.11 0.12 1.0"/>
  </material>
  <material name="team_yellow">
    <color rgba="0.55 0.53 0.30 1.0"/>
  </material>
  <material name="head_dark">
    <color rgba="0.42 0.43 0.45 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="12.0000"/>
      <inertia ixx="0.403406" ixy="0" ixz="0" iyy="0.577738" iyz="0" izz="0.273394"/>
    </inertial>
    <visual name="base_link_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/base_link.obj" scale="1 1 1"/>
      </geometry>
      <material name="body_grey"/>
    </visual>
  </link>

  <link name="wheel_front_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8000"/>
      <inertia ixx="0.002006" ixy="0" ixz="0" iyy="0.001749" iyz="0" izz="0.002029"/>
    </inertial>
    <visual name="wheel_front_left_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/wheel_front_left.obj" scale="1 1 1"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>
  </link>

  <link name="wheel_front_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.8000"/>
      <inertia ixx="0.001945" ixy="0" ixz="0" iyy="0.001641" iyz="0" izz="0.001988"/>
    </inertial>
    <visual name="wheel_front_right_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/wheel_front_right.obj" scale="1 1 1"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>
  </link>

  <link name="steer_rear_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.9000"/>
      <inertia ixx="0.003483" ixy="0" ixz="0" iyy="0.002243" iyz="0" izz="0.003924"/>
    </inertial>
    <visual name="steer_rear_left_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/steer_rear_left.obj" scale="1 1 1"/>
      </geometry>
      <material name="steer_grey"/>
    </visual>
  </link>

  <link name="steer_rear_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.9000"/>
      <inertia ixx="0.003535" ixy="0" ixz="0" iyy="0.002291" iyz="0" izz="0.004008"/>
    </inertial>
    <visual name="steer_rear_right_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/steer_rear_right.obj" scale="1 1 1"/>
      </geometry>
      <material name="steer_grey"/>
    </visual>
  </link>

  <link name="wheel_rear_left">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6000"/>
      <inertia ixx="0.001399" ixy="0" ixz="0" iyy="0.000979" iyz="0" izz="0.001015"/>
    </inertial>
    <visual name="wheel_rear_left_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/wheel_rear_left.obj" scale="1 1 1"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>
  </link>

  <link name="wheel_rear_right">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.6000"/>
      <inertia ixx="0.001399" ixy="0" ixz="0" iyy="0.000979" iyz="0" izz="0.001016"/>
    </inertial>
    <visual name="wheel_rear_right_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/wheel_rear_right.obj" scale="1 1 1"/>
      </geometry>
      <material name="rubber_black"/>
    </visual>
  </link>

  <link name="gimbal_yaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3.0000"/>
      <inertia ixx="0.066849" ixy="0" ixz="0" iyy="0.077181" iyz="0" izz="0.076983"/>
    </inertial>
    <visual name="gimbal_yaw_link_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/gimbal_yaw_link.obj" scale="1 1 1"/>
      </geometry>
      <material name="team_yellow"/>
    </visual>
  </link>

  <link name="gimbal_pitch_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.6000"/>
      <inertia ixx="0.025422" ixy="0" ixz="0" iyy="0.025607" iyz="0" izz="0.013411"/>
    </inertial>
    <visual name="gimbal_pitch_link_visual">
      <origin xyz="0 0 0" rpy="1.5707963268 0 -1.5707963268"/>
      <geometry>
        <mesh filename="meshes/gimbal_pitch_link.obj" scale="1 1 1"/>
      </geometry>
      <material name="head_dark"/>
    </visual>
  </link>

  <link name="camera_link"/>
  <link name="camera_optical_frame"/>
  <link name="shot_direction"/>

  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.185226 0.155006 0.065050" rpy="0 0 0"/>
    <axis xyz="0.000000 -1.000000 0.000000"/>
  </joint>

  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.185226 -0.155006 0.065050" rpy="0 0 0"/>
    <axis xyz="0.000000 -1.000000 0.000000"/>
  </joint>

  <joint name="steer_rear_left_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steer_rear_left"/>
    <origin xyz="-0.175000 0.153399 0.128478" rpy="0 0 0"/>
    <axis xyz="-0.000000 -0.000000 1.000000"/>
    <limit lower="-3.141590" upper="3.141590" effort="5.0" velocity="3.0"/>
  </joint>

  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="steer_rear_left"/>
    <child link="wheel_rear_left"/>
    <origin xyz="0.000000 0.001601 -0.068500" rpy="0 0 0"/>
    <axis xyz="0.000000 -1.000000 0.000000"/>
  </joint>

  <joint name="steer_rear_right_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steer_rear_right"/>
    <origin xyz="-0.175000 -0.153399 0.128478" rpy="0 0 0"/>
    <axis xyz="-0.000000 -0.000000 1.000000"/>
    <limit lower="-3.141590" upper="3.141590" effort="5.0" velocity="3.0"/>
  </joint>

  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="steer_rear_right"/>
    <child link="wheel_rear_right"/>
    <origin xyz="0.000000 -0.001601 -0.068500" rpy="0 0 0"/>
    <axis xyz="0.000000 -1.000000 0.000000"/>
  </joint>

  <joint name="gimbal_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="gimbal_yaw_link"/>
    <origin xyz="0.007531 0.000321 0.139978" rpy="0 0 0"/>
    <axis xyz="-0.000000 -0.000000 1.000000"/>
    <limit lower="-3.141590" upper="3.141590" effort="5.0" velocity="3.0"/>
  </joint>

  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="gimbal_yaw_link"/>
    <child link="gimbal_pitch_link"/>
    <origin xyz="0.059615 -0.029985 0.215000" rpy="0 0 0"/>
    <axis xyz="0.000000 1.000000 0.000000"/>
    <limit lower="-0.523600" upper="0.523600" effort="5.0" velocity="3.0"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="gimbal_pitch_link"/>
    <child link="camera_link"/>
    <origin xyz="0.136730 0.063570 0.043224" rpy="0 0 0"/>
  </joint>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.000000 0.000000 0.000000" rpy="-1.570796 0.000000 -1.570796"/>
  </joint>

  <joint name="shot_joint" type="fixed">
    <parent link="gimbal_pitch_link"/>
    <child link="shot_direction"/>
    <origin xyz="0.117980 0.063570 -0.000317" rpy="0 0 0"/>
  </joint>

</robot>
