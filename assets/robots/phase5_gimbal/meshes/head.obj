# Phase 5 sample head mesh.
# Authored in the Godot frame (metres, +Y up, -Z forward), as the Phase 5
# mesh convention requires: loaders never rotate mesh geometry, and
# tools/prepare_robot_model.py converts ROS/URDF-frame meshes to this frame.
# A simple 0.12 x 0.10 x 0.14 m box; the -Z face is the "lens" side.
o phase5_head
v -0.06 0.00 0.07
v 0.06 0.00 0.07
v 0.06 0.10 0.07
v -0.06 0.10 0.07
v -0.06 0.00 -0.07
v 0.06 0.00 -0.07
v 0.06 0.10 -0.07
v -0.06 0.10 -0.07
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 1.0
vn 1.0 0.0 0.0
vn -1.0 0.0 0.0
# top (+Y)
f 4//1 3//1 7//1
f 4//1 7//1 8//1
# bottom (-Y)
f 1//2 5//2 6//2
f 1//2 6//2 2//2
# front (-Z, lens side)
f 5//3 8//3 7//3
f 5//3 7//3 6//3
# back (+Z)
f 1//4 2//4 3//4
f 1//4 3//4 4//4
# right (+X)
f 2//5 6//5 7//5
f 2//5 7//5 3//5
# left (-X)
f 1//6 4//6 8//6
f 1//6 8//6 5//6
